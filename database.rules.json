{
  "rules": {
    ".read": true,
    ".write": false,

    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'email'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "displayName": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "whatsapp": {
          ".validate": "newData.isString()"
        },
        "role": {
          ".validate": "newData.val() === 'member' || newData.val() === 'admin'"
        },
        "lastLogin": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "promo": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "orders": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".validate": "newData.hasChildren(['buyerName', 'buyerPhone', 'items', 'total', 'createdAt'])"
        }
      }
    }
  }
}
