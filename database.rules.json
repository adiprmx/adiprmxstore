{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'email'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "displayName": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "whatsapp": {
          ".validate": "newData.isString()"
        },
        "role": {
          ".validate": "newData.val() === 'member' || newData.val() === 'admin'"
        },
        "lastLogin": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "promo": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "carts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "buyerName": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$orderId": {
          ".validate": "newData.hasChildren(['buyerName', 'items', 'total', 'createdAt'])"
        }
      }
    },

    "transactions": {
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$txnId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['buyerId', 'productId', 'status', 'createdAt'])",
        "buyerId": {
          ".validate": "newData.isString()"
        },
        "buyerEmail": {
          ".validate": "newData.isString()"
        },
        "userId": {
          ".validate": "newData.isString()"
        },
        "productId": {
          ".validate": "newData.isString()"
        },
        "productName": {
          ".validate": "newData.isString()"
        },
        "note": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'PENDING' || newData.val() === 'LUNAS'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "createdBy": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
