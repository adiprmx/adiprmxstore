{
  "rules": {
    ".read": false,
    ".write": false,

    // ==================================================================
    // /users -> HANYA BISA DI-WRITE oleh:
    //   (1) Super Admin hardcode (adiprmx@gmail.com), ATAU
    //   (2) akun dengan role "admin" di database, ATAU
    //   (3) pemilik akun sendiri (auth.uid === $uid) -- KHUSUS untuk
    //       sinkronisasi profil (nama, foto, lastLogin, dst) saat login.
    // Field "role" dijaga KETAT lewat .validate di level $uid: user biasa
    // TIDAK BISA menaikkan role dirinya sendiri jadi admin (request macam
    // itu DITOLAK KERAS oleh server Google), dia hanya boleh menulis
    // role="member" untuk dirinya sendiri. Hanya Super Admin / admin yang
    // boleh mengubah role SIAPA PUN jadi "admin".
    // ==================================================================
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'email']) && (newData.child('role').val() === data.child('role').val() || newData.child('role').val() === 'member' || auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "displayName": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "whatsapp": {
          ".validate": "newData.isString()"
        },
        "role": {
          // Lapisan proteksi tambahan langsung di field role itu sendiri.
          ".write": "auth != null && (auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.val() === 'member' || newData.val() === 'admin'"
        },
        "lastLogin": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "promo": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "carts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "buyerName": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "orders": {
      ".read": "auth != null && (auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$orderId": {
          ".validate": "newData.hasChildren(['buyerName', 'items', 'total', 'createdAt'])"
        }
      }
    },

    // ==================================================================
    // /transactions -> HANYA BISA DI-WRITE oleh Super Admin
    // (adiprmx@gmail.com) atau akun dengan role "admin" di database.
    // Request dari user/hacker biasa WAJIB DITOLAK KERAS oleh server.
    // ==================================================================
    "transactions": {
      ".write": "auth != null && (auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$txnId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || auth.token.email === 'adiprmx@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['buyerId', 'productId', 'status', 'createdAt'])",
        "buyerId": {
          ".validate": "newData.isString()"
        },
        "buyerEmail": {
          ".validate": "newData.isString()"
        },
        "userId": {
          ".validate": "newData.isString()"
        },
        "productId": {
          ".validate": "newData.isString()"
        },
        "productName": {
          ".validate": "newData.isString()"
        },
        "note": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'PENDING' || newData.val() === 'LUNAS'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "createdBy": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
