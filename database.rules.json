{
  "rules": {
    ".read": true,
    ".write": false,

    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'email'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "phone": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'member' || newData.val() === 'admin'"
        }
      }
    },

    "products": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'admin'"
    },

    "promo": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'admin'"
    },

    "orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'admin'",
      "$orderId": {
        ".write": "auth != null"
      }
    }
  }
}
